# Required: dashboard login and signed session cookies
OPENCHAT_ADMIN_PASSWORD=choose-a-long-admin-password
OPENCHAT_SESSION_SECRET=generate-at-least-32-random-characters

# Public project link shown on the landing page and legal pages.
# Set this to the URL of your fork before publishing your deployment.
NEXT_PUBLIC_OPENCHAT_REPOSITORY_URL=https://github.com/your-account/openchat

# Optional: only enable behind a trusted identity-aware private hosting layer
# OPENCHAT_TRUST_PLATFORM_AUTH=true

# Optional advanced Telegram override. Most administrators connect Telegram
# from Dashboard -> Settings -> Channels instead.
# OPENCHAT_PUBLIC_URL=https://your-openchat.example.com
# TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Instagram API with Instagram Login. These values belong to the installation's
# Meta developer app; connected-account access tokens are encrypted in D1.
# INSTAGRAM_APP_ID=replace-with-instagram-app-id
# INSTAGRAM_APP_SECRET=replace-with-instagram-app-secret
# FACEBOOK_APP_SECRET=replace-with-facebook-app-secret
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
# META_GRAPH_API_VERSION=v25.0
# INSTAGRAM_HUMAN_AGENT_ENABLED=false
# OPENCHAT_PUBLIC_URL=https://your-openchat.example.com

# Optional advanced AI override. Most administrators connect OpenRouter
# from Dashboard -> Settings -> AI assistant instead.
# OPENCHAT_AI_PROVIDER=openrouter
# OPENAI_API_KEY=replace-with-provider-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openrouter/auto

# Cloudflare deployment only (not exposed to the Worker runtime)
OPENCHAT_D1_DATABASE_NAME=openchat
OPENCHAT_D1_DATABASE_ID=replace-with-cloudflare-d1-database-id
OPENCHAT_R2_BUCKET_NAME=openchat-media
